#:schema https://developers.openai.com/codex/config-schema.json
#
# Free Codex local OmniRoute proxy (fc-server).
#
# Codex/VS Code always talks only to this local endpoint. Choose NVIDIA, Ollama,
# custom OpenAI-compatible providers, or Puter Web in Free Codex configuration;
# do not put upstream credentials or upstream URLs in this file.

# This can be a configured alias, e.g. puter/deepseek-flash. fc-init or
# fc-codex --provider/--model can choose a model without changing base_url.
model = "minimaxai/minimax-m2.7"
model_provider = "free_codex"

[model_providers.free_codex]
name = "Free Codex (local OmniRoute proxy)"
base_url = "http://127.0.0.1:8080/v1"
# Preferred agentic surface: POST /v1/responses.
wire_api = "responses"

# Legacy provider ID retained for older Codex config files.
[model_providers.free_codex_nim]
name = "Free Codex (local provider router; legacy NIM alias)"
base_url = "http://127.0.0.1:8080/v1"
wire_api = "responses"

[windows]
sandbox = "elevated"
