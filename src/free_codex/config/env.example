# Free Codex OmniRoute configuration
#
# Existing NVIDIA_NIM_* values remain fully supported. The local Codex URL is
# always http://127.0.0.1:8080/v1; upstream choice happens inside fc-server.

# --- Backwards-compatible NVIDIA NIM ---
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=your_nvidia_api_key_here
NVIDIA_NIM_MODEL=minimaxai/minimax-m2.7
# NVIDIA_NIM_ENABLED=1

# --- Router ---
# FREE_CODEX_DEFAULT_PROVIDER=nvidia
# FREE_CODEX_PROVIDERS_CONFIG=~/.config/free-codex/providers.toml
# FREE_CODEX_MODEL_ROUTES={"puter/deepseek-flash":"puter_web::deepseek/deepseek-v4.1-flash"}
# FREE_CODEX_MODEL_ALIASES={"fast-local":"ollama::llama3.2"}

# --- Ollama / local / generic OpenAI-compatible providers ---
# OLLAMA_ENABLED=1
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_API_KEY=ollama
# OLLAMA_MODEL=llama3.2
#
# LOCAL_OPENAI_ENABLED=1
# LOCAL_OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# LOCAL_OPENAI_API_KEY=
# LOCAL_OPENAI_MODEL=your-local-model
#
# CUSTOM_OPENAI_ENABLED=1
# CUSTOM_OPENAI_BASE_URL=https://your-api.example/v1
# CUSTOM_OPENAI_API_KEY=your_key
# CUSTOM_OPENAI_MODEL=your-model

# --- Puter Web (official browser-side Puter.js SDK; no paid OpenAI endpoint) ---
# PUTER_WEB_ENABLED=1
# PUTER_WEB_MODEL=deepseek/deepseek-v4.1-flash
# PUTER_WEB_BROWSER=chromium          # chromium, chrome, edge, or executable path
# PUTER_WEB_HEADLESS=1                # normal operation is hidden/background
# PUTER_WEB_PROFILE_DIR=~/.config/free-codex/puter-profile
# PUTER_WEB_AUTH_TIMEOUT=300
# PUTER_WEB_CONNECT_TIMEOUT=30
# PUTER_WEB_SESSION_TIMEOUT=3600
# PUTER_WEB_REQUEST_TIMEOUT=900
# PUTER_WEB_MAX_CONCURRENT_REQUESTS=1
# PUTER_WEB_AUTO_START=0

# --- Reliability ---
# FREE_CODEX_PORT=8080
# FREE_CODEX_HOST=0.0.0.0
# FREE_CODEX_READ_TIMEOUT=900
# FREE_CODEX_CONNECT_TIMEOUT=60
# FREE_CODEX_MAX_RETRIES=5
# FREE_CODEX_SSE_HEARTBEAT_SECS=20
# FREE_CODEX_DEBUG_PROVIDER_PAYLOADS=0
